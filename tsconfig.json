{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "strict": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "types": [
      "node",
      "@playwright/test"
    ],

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "tests",
    "scripts",
    "config",
    "src",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}