# =====================================================
# Application
# =====================================================

# URL de la aplicación bajo prueba
BASE_URL=https://example.com

# Credenciales de ReservaLab usadas por la automatización de SCRUM-11
RESERVALAB_EMAIL=
RESERVALAB_PASSWORD=

# =====================================================
# Playwright
# =====================================================

# Navegador: chromium | firefox | webkit
BROWSER=chromium

# Ejecutar en modo headless
HEADLESS=true

# Carpeta donde se almacenan los reportes
REPORTS_PATH=reports

# Carpeta donde se almacenan las evidencias
EVIDENCE_PATH=evidence

# =====================================================
# Jira Cloud
# =====================================================

# URL de Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net

# Usuario de Jira
JIRA_EMAIL=your-email@example.com

# API Token de Jira
JIRA_API_TOKEN=your-api-token

# Clave del proyecto
JIRA_PROJECT_KEY=SCRUM

# =====================================================
# Jira Workflow
# =====================================================

# Estado al iniciar la automatización
JIRA_STATUS_TEST_DOING=Pruebas Doing

# Estado al finalizar correctamente
JIRA_STATUS_TEST_DONE=Pruebas Done